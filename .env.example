HTTP_PORT=8080
DATABASE_URL=postgres://app:local_dev_password@localhost:5432/wallet?sslmode=disable
JWKS_URL=http://localhost:8081/realms/wagering/protocol/openid-connect/certs
# Tokens must come from this issuer and be meant for this audience
JWT_ISSUER=http://localhost:8081/realms/wagering
JWT_AUDIENCE=wallet-api
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
OUTBOX_PUBLISH_INTERVAL=2
REFERENCE_RETRY_INTERVAL=15
LOG_LEVEL=info
ADMIN_ADDR=127.0.0.1:6060
PPROF_ENABLED=false
DB_MAX_OPEN_CONNS=10
DB_MIN_CONNS=2
# PostgreSQL session limits on every pooled connection
DB_STATEMENT_TIMEOUT=5s
DB_IDLE_IN_TRANSACTION_TIMEOUT=10s
DB_LOCK_TIMEOUT=2s
# Deadline of every authenticated request; past it the API answers 503 TIMEOUT
REQUEST_TIMEOUT=5s
OUTBOX_BATCH_SIZE=20
JWKS_REFRESH_INTERVAL=3600
# Tracing stays off without an OTLP endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=go-high-load-wallet
